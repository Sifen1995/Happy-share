{
  "name": "happy-share-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "db:up": "docker compose up -d db pgadmin",
    "db:down": "docker compose down",
    "migrate:up": "node-pg-migrate up -m db/migrations -d DATABASE_URL",
    "migrate:down": "node-pg-migrate down -m db/migrations -d DATABASE_URL",
    "migrate:create": "node-pg-migrate create -m db/migrations"
  },
  "devDependencies": {
    "node-pg-migrate": "^8.0.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0"
  }
}
